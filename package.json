{
  "name": "pr-flow-review",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:prepare": "node scripts/desktop/prepare.cjs",
    "desktop:dev": "npm run build && node scripts/desktop/dev.cjs",
    "desktop:build": "node scripts/desktop/build.cjs",
    "desktop:release": "node scripts/desktop/build.cjs --release",
    "desktop:test": "node --test tests/desktop/*.test.cjs",
    "desktop:smoke": "node tests/desktop/smoke.cjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@xyflow/react": "^12.9.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.52",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "main": "desktop/main.cjs",
  "description": "Local source-backed pull request review for macOS",
  "author": "PR Flow Review contributors"
}
